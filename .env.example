# Orbit local configuration
APP_NAME=Orbit
COMPANY_NAME=Orbit
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# Local PostgreSQL database. Create the `orbit` database before starting the backend.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/orbit

# Authentication
SECRET_KEY=local-only-change-this-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
INITIAL_ADMIN_EMAIL=

# Only the two local Vite applications may call the backend.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
CORS_ORIGIN_REGEX=
FRONTEND_ORIGIN=http://localhost:5173

# LLM: choose google, groq, openai or openrouter.
LLM_PROVIDER=google
MODEL_NAME=gemini-2.5-flash
GOOGLE_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME=Orbit
OPENROUTER_REASONING_EFFORT=low
LLM_MAX_OUTPUT_TOKENS=384
DAILY_TOKEN_BUDGET=350000

# Optional local multi-agent features. Runtimes stay embedded in the backend process.
MULTI_AGENT_ENABLED=false
PRODUCT_DELIVERY_AGENT_ENABLED=false
QUALITY_ASSURANCE_AGENT_ENABLED=false
EXECUTIVE_AGENT_ENABLED=false
WORKSPACE_AGENT_RUNTIME_MODE=embedded
PRODUCT_DELIVERY_HYBRID_ROUTER_ENABLED=true
PRODUCT_DELIVERY_SUPERVISOR_ENABLED=true
PRODUCT_DELIVERY_MULTI_SPECIALIST_WORKFLOWS_ENABLED=true
PRODUCT_DELIVERY_SPECIALIST_LLM_ENABLED=true
WORKSPACE_AGENT_VERIFIER_ENABLED=true
ALLOW_SELF_SERVICE_ORGANIZATION_CREATION=false
OPEN_TEST_CHAT_ENABLED=false
DEMO_LOGIN_ENABLED=false

# Optional Google Sign-In.
GOOGLE_OAUTH_CLIENT_ID=

# Optional per-user Google Calendar connection.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:8000/api/v1/calendar/oauth/callback
CALENDAR_TIMEZONE=Asia/Ho_Chi_Minh
CREDENTIAL_ENCRYPTION_KEY=
CALENDAR_POLL_INTERVAL_SECONDS=20

# Request limits and scheduler.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_REGISTER=5/minute
RATE_LIMIT_CHAT=15/minute
RATE_LIMIT_READ=300/minute
RATE_LIMIT_CRUD=60/minute
SCHEDULER_TIMEZONE=Asia/Ho_Chi_Minh

# Optional LangSmith tracing for personal debugging/evaluation.
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=orbit-local
LANGCHAIN_TRACING_V2=false
