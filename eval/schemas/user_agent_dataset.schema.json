{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/user-agent-dataset-v1.json",
  "title": "User Agent Acceptance Dataset",
  "type": "object",
  "required": [
    "dataset_id",
    "version",
    "schema_version",
    "locale",
    "timezone",
    "evaluation_policy",
    "safety",
    "coverage",
    "seed",
    "evaluation_cases"
  ],
  "properties": {
    "dataset_id": {"type": "string", "minLength": 3},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "schema_version": {"const": "1.0"},
    "title": {"type": "string"},
    "description": {"type": "string"},
    "locale": {"const": "vi-VN"},
    "timezone": {"type": "string", "minLength": 1},
    "clock_policy": {"type": "object"},
    "evaluation_policy": {
      "type": "object",
      "required": ["default_repetitions", "release_thresholds", "reported_metrics", "manual_or_judged_metrics"],
      "properties": {
        "default_repetitions": {"type": "integer", "minimum": 1},
        "release_thresholds": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}
        },
        "reported_metrics": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "manual_or_judged_metrics": {"type": "array", "items": {"type": "string"}}
      }
    },
    "safety": {
      "type": "object",
      "required": ["synthetic", "contains_real_personal_data", "email_domain", "prohibited_environment"],
      "properties": {
        "synthetic": {"const": true},
        "contains_real_personal_data": {"const": false},
        "email_domain": {"const": "example.com"},
        "allowed_environments": {"type": "array", "items": {"type": "string"}},
        "prohibited_environment": {"const": "production"}
      },
      "additionalProperties": true
    },
    "coverage": {
      "type": "object",
      "required": ["capabilities", "primary_user_id", "workspace_id"],
      "properties": {
        "capabilities": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "primary_user_id": {"type": "string"},
        "workspace_id": {"type": "string"}
      }
    },
    "seed": {
      "type": "object",
      "required": ["default_password", "users", "workspace", "conversations", "tasks", "memories"],
      "properties": {
        "default_password": {"type": "string", "minLength": 12},
        "users": {
          "type": "array",
          "minItems": 2,
          "items": {"$ref": "#/$defs/user"}
        },
        "workspace": {"$ref": "#/$defs/workspace"},
        "conversations": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/conversation"}
        },
        "tasks": {
          "type": "array",
          "items": {"$ref": "#/$defs/task"}
        },
        "memories": {
          "type": "array",
          "items": {"$ref": "#/$defs/memory"}
        }
      }
    },
    "evaluation_cases": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/evaluationCase"}
    }
  },
  "$defs": {
    "user": {
      "type": "object",
      "required": ["id", "email_local", "display_name", "job_title", "timezone"],
      "properties": {
        "id": {"type": "string"},
        "email_local": {"type": "string", "pattern": "^[a-z0-9._-]+$"},
        "display_name": {"type": "string"},
        "job_title": {"type": "string"},
        "timezone": {"type": "string"}
      }
    },
    "workspace": {
      "type": "object",
      "required": ["id", "name", "type", "members"],
      "properties": {
        "id": {"type": "string"},
        "name": {"type": "string"},
        "type": {"enum": ["organization"]},
        "members": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["user_id", "role"],
            "properties": {
              "user_id": {"type": "string"},
              "role": {"enum": ["owner", "admin", "member", "guest"]}
            }
          }
        }
      }
    },
    "conversation": {
      "type": "object",
      "required": ["id", "type", "name", "created_by", "ai_policy", "participants", "messages"],
      "properties": {
        "id": {"type": "string"},
        "case_ref": {"type": "string"},
        "type": {"enum": ["direct", "group"]},
        "name": {"type": "string"},
        "created_by": {"type": "string"},
        "ai_policy": {
          "type": "object",
          "required": ["enabled", "enabled_by"],
          "properties": {
            "enabled": {"type": "boolean"},
            "enabled_by": {"type": "string"}
          }
        },
        "participants": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["user_id", "resource_role"],
            "properties": {
              "user_id": {"type": "string"},
              "resource_role": {"enum": ["manager", "participant", "viewer"]}
            }
          }
        },
        "messages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "sender_id", "offset_minutes", "content"],
            "properties": {
              "id": {"type": "string"},
              "sender_id": {"type": "string"},
              "offset_minutes": {"type": "integer"},
              "content": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "relativeDate": {
      "type": ["object", "null"],
      "properties": {
        "type": {"enum": ["offset_days", "next_weekday"]},
        "days": {"type": "integer"},
        "weekday": {"type": "integer", "minimum": 0, "maximum": 6},
        "hour": {"type": "integer", "minimum": 0, "maximum": 23},
        "minute": {"type": "integer", "minimum": 0, "maximum": 59},
        "tolerance_minutes": {"type": "integer", "minimum": 0}
      }
    },
    "task": {
      "type": "object",
      "required": ["id", "owner_id", "title", "due", "priority", "status", "source"],
      "properties": {
        "id": {"type": "string"},
        "owner_id": {"type": "string"},
        "conversation_id": {"type": ["string", "null"]},
        "title": {"type": "string"},
        "due": {"$ref": "#/$defs/relativeDate"},
        "priority": {"enum": ["High", "Medium", "Low"]},
        "status": {"enum": ["suggested", "pending", "in_progress", "completed", "dismissed", "invalidated"]},
        "source": {"enum": ["manual", "ai_extracted", "proactive"]}
      }
    },
    "memory": {
      "type": "object",
      "required": ["id", "owner_id", "category", "title", "detail", "memory_type", "sensitivity", "confidence", "expires"],
      "properties": {
        "id": {"type": "string"},
        "owner_id": {"type": "string"},
        "category": {"type": "string"},
        "title": {"type": "string"},
        "detail": {"type": "string"},
        "memory_type": {"enum": ["preference", "relationship", "episodic", "semantic"]},
        "sensitivity": {"enum": ["normal", "sensitive"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "expires": {"$ref": "#/$defs/relativeDate"}
      }
    },
    "evaluationCase": {
      "type": "object",
      "required": ["id", "capability", "actor_id", "prompt", "expected"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Z]+(?:-[A-Z]+)?-[0-9]{2}$"},
        "capability": {"type": "string"},
        "conversation_id": {"type": "string"},
        "actor_id": {"type": "string"},
        "prompt": {"type": "string", "minLength": 1},
        "expected": {"type": "object", "minProperties": 1}
      }
    }
  }
}
